PORT=5000

# --- MongoDB ---
# 로컬
# MONGODB_URI=mongodb://127.0.0.1:27017/sapal-diary

# MongoDB Atlas: Atlas 웹 콘솔 → Database → Connect → Drivers → 연결 문자열 복사
# USER / PASSWORD / 호스트 / DB 이름(sapal-diary 등)을 본인 값으로 바꿉니다.
# 비밀번호에 @ : / ? # [ ] 등이 있으면 반드시 URL 인코딩합니다.
# Atlas → Network Access에서 접속 IP(개발: 0.0.0.0/0) 허용 여부를 확인합니다.
MONGODB_URI=mongodb+srv://purpleantdev_db_user:q9yp9KHs47qn3hUq@cluster0.xxxxx.mongodb.net/sapal-diary?retryWrites=true&w=majority

JWT_SECRET=replace-to-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# 관리자: DB에서 userType을 admin으로 설정한 뒤, 그 계정으로 다시 로그인하세요.
# mongosh 예: db.users.updateOne({ email: "you@example.com" }, { $set: { userType: "admin" } })
